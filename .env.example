# LeadFlow configuration. Copy to .env for local development.

# PostgreSQL connection (required). `docker compose up -d` starts one matching this URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadflow"

# Public URL of this app: used in email links (unsubscribe, booking) and the widget snippet.
PUBLIC_BASE_URL="http://localhost:3000"
PORT=3000

# Create the demo clinic on boot (demo@leadflow.local / demo1234). Defaults to true outside production.
# SEED_DEMO=true

# Email delivery via Resend (optional). Without a key, emails are written and logged in the
# dashboard's Emails page instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="Your Clinic <hello@your-domain.com>"

# Claude answers (optional). With a key, open questions (treatments, comparisons, follow-ups and
# questions the built-in assistant can't answer) are answered by Claude from each clinic's own
# knowledge base; emergencies, booking, prices and hours stay built in. Each clinic can switch it
# off in Settings > Assistant. Without a key, everything runs on this server.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=claude-opus-5-5     # claude-sonnet-5-5 or claude-haiku-5-5 cost less per answer
# ANTHROPIC_EFFORT=low                # low | medium | high
# CLAUDE_TIMEOUT_MS=15000             # after this the built-in answer is used
# CLAUDE_DAILY_LIMIT=500              # Claude answers per clinic per 24 hours

# Stripe subscription billing (optional). Leave empty to keep billing off.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Background worker that sends follow-ups and alerts (on by default).
# RUN_WORKER=true
# WORKER_INTERVAL_MS=30000

# Tests: a PostgreSQL server the API tests may create throwaway databases on.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
