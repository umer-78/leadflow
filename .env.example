# LeadFlow AI - Environment Variables Configuration
# Free-First $0 Capital Architecture

# Database (PostgreSQL / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadflow_ai?schema=public"

# Authentication
AUTH_SECRET="leadflow_production_jwt_signing_secret_min_32_chars"

# AI Gateway Configuration (Google Cloud Gemini API)
AI_PROVIDER="gemini"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Email Provider Configuration (Mock by default for $0 development)
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""

# Billing Provider Configuration (Mock by default for $0 development)
BILLING_PROVIDER="mock"
BILLING_API_KEY=""

# Stripe card checkout (optional). Leave unset to stay in demo mode; set these to
# turn on real subscription checkout for the Starter/Growth/Pro plans.
#   STRIPE_SECRET_KEY        — your Stripe secret key (sk_live_... or sk_test_...)
#   STRIPE_WEBHOOK_SECRET    — signing secret for the /api/billing/webhook endpoint
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Public Application URL (used to build Stripe success/cancel return URLs)
APP_URL="http://localhost:3000"
# PUBLIC_BASE_URL overrides the auto-detected host for Stripe return URLs if needed.
# PUBLIC_BASE_URL="https://app.yourdomain.com"
